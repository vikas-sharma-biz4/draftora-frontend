#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "▶ Running pre-commit checks..."

# Type check
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "✖ TypeScript check failed. Commit aborted."
  exit 1
fi

# Lint
npm run lint
if [ $? -ne 0 ]; then
  echo "✖ ESLint check failed. Commit aborted."
  exit 1
fi

echo "✔ Pre-commit checks passed."

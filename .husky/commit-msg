#!/bin/sh
# Enforce Conventional Commits format:
# type(scope): subject
# e.g. feat(auth): add login page
#      fix(proposals): resolve section reorder bug
#      chore: update dependencies

COMMIT_MSG_FILE="$1"
# Strip carriage returns so Windows CRLF commit messages don't break the regex
COMMIT_MSG=$(tr -d '\r' < "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "✖ Invalid commit message format."
  echo ""
  echo "  Expected: type(scope): subject"
  echo "  Example:  feat(proposals): add section reorder"
  echo ""
  echo "  Valid types: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert"
  echo ""
  exit 1
fi

echo "✔ Commit message format is valid."

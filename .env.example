# Backend API URL (REQUIRED - no fallback, must be set in .env or CI/CD)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default AI model for proposal generation
NEXT_PUBLIC_DEFAULT_AI_MODEL=gpt-4o

# Auth middleware — set to "true" to enforce server-side redirects for protected routes.
# Until auth backend is fully wired, leave unset or "false" for audit-only mode.
# IMPORTANT: Must be set to "true" in .env.production for production deployments.
AUTH_ENABLED=false

# Name of the httpOnly session cookie set by the backend (default: draftora_session)
DRAFTORA_SESSION_COOKIE=draftora_session

# Sentry error tracking DSN (optional — set to enable production error monitoring)
# Install @sentry/nextjs first: npm install @sentry/nextjs
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
